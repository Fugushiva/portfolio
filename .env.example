# ─── Contact Form ────────────────────────────────────────────────────────────

# n8n webhook — n8n handles all email sending
# IMPORTANT: Use /webhook/<uuid> for production (workflow must be activated via the toggle).
#            Use /webhook-test/<uuid> ONLY when the n8n editor is open and "Listen for test event"
#            is active — it stops listening after the first hit and is NOT for production use.
N8N_WEBHOOK_URL=https://n8n.yourdomain.com/webhook/YOUR-WEBHOOK-UUID

# Shared secret — set the same value in your n8n Webhook node (Header Auth)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
N8N_WEBHOOK_SECRET=your-generated-secret

# ─── Vercel deployment checklist ─────────────────────────────────────────────
# 1. Add N8N_WEBHOOK_URL as Text in Vercel env vars
# 2. Add N8N_WEBHOOK_SECRET as Secret in Vercel env vars
# 3. In n8n Webhook node → Authentication → Header Auth
#    Header name: x-portfolio-secret  |  Value: same as N8N_WEBHOOK_SECRET
