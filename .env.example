# ─── Contact Form — Required ────────────────────────────────────────────────
# Resend (https://resend.com) — email sending
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Verified sender domain (must be set up in Resend dashboard with SPF/DKIM/DMARC)
RESEND_FROM="Portfolio <hello@jeromedelodder.com>"
# Where to receive contact form submissions
RESEND_TO=jerome@delodder.dev

# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile)
# Site key is PUBLIC — safe to expose in client bundle
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAA_XXXXXXXXXXXXXXXXXXXX
# Secret is SERVER-ONLY — never prefix with NEXT_PUBLIC_
TURNSTILE_SECRET=0x4AAAAAAAA_YYYYYYYYYYYYYYYY

# ─── Contact Form — Cloudflare Bindings (wrangler.toml) ─────────────────────
# KV namespace binding for rate limiting.
# Add to wrangler.toml:
#   [[kv_namespaces]]
#   binding = "CONTACT_RATE_LIMIT"
#   id = "your-kv-namespace-id"
# In local dev, the code falls back to an in-memory Map (no setup needed).

# ─── n8n Webhook — Optional (future) ────────────────────────────────────────
# Leave empty to disable n8n integration. The code is a no-op when URL is absent.
N8N_WEBHOOK_URL=
# Shared secret — must match x-portfolio-secret header check in your n8n workflow
N8N_WEBHOOK_SECRET=

# ─── Cloudflare Deployment Checklist ────────────────────────────────────────
# 1. Create KV namespace "CONTACT_RATE_LIMIT" in CF dashboard
# 2. Add binding in wrangler.toml (see above)
# 3. Add all env vars (except KV binding) to CF Pages > Settings > Environment variables
# 4. Verify domain jeromedelodder.com in Resend (add SPF/DKIM/DMARC DNS records)
# 5. Create Turnstile site → copy site key + secret
# 6. Deploy preview → run smoke test checklist (see spec doc)
