# ─── Contact Form ────────────────────────────────────────────────────────────

# Cloudflare Turnstile — https://dash.cloudflare.com → Turnstile
# Site key is PUBLIC (safe to expose in client bundle)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Turnstile secret is SERVER-ONLY (never prefix with NEXT_PUBLIC_)
TURNSTILE_SECRET=your-turnstile-secret

# n8n webhook — n8n handles all email sending
# IMPORTANT: Use /webhook/<uuid> for production (workflow must be activated via the toggle).
#            Use /webhook-test/<uuid> ONLY when the n8n editor is open and "Listen for test event"
#            is active — it stops listening after the first hit and is NOT for production use.
N8N_WEBHOOK_URL=https://n8n.yourdomain.com/webhook/YOUR-WEBHOOK-UUID

# Shared secret — set the same value in your n8n Webhook node (Header Auth)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
N8N_WEBHOOK_SECRET=your-generated-secret

# ─── Vercel deployment checklist ─────────────────────────────────────────────
# 1. Create Turnstile site → copy site key (Text) + secret (Secret)
# 2. Add NEXT_PUBLIC_TURNSTILE_SITE_KEY as Text in Vercel env vars
# 3. Add TURNSTILE_SECRET as Secret in Vercel env vars
# 4. Add N8N_WEBHOOK_URL as Text in Vercel env vars
# 5. Add N8N_WEBHOOK_SECRET as Secret in Vercel env vars
# 6. In n8n Webhook node → Authentication → Header Auth
#    Header name: x-portfolio-secret  |  Value: same as N8N_WEBHOOK_SECRET
