# ─── Contact Form ────────────────────────────────────────────────────────────

# Cloudflare Turnstile — https://dash.cloudflare.com → Turnstile
# Site key is PUBLIC (safe to expose in client bundle)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Turnstile secret is SERVER-ONLY (never prefix with NEXT_PUBLIC_)
TURNSTILE_SECRET=your-turnstile-secret

# n8n webhook — n8n handles all email sending
# Use /webhook/ for production, /webhook-test/ for n8n editor testing
N8N_WEBHOOK_URL=https://n8n.yourdomain.com/webhook/YOUR-WEBHOOK-UUID

# Shared secret — set the same value in your n8n Webhook node (Header Auth)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
N8N_WEBHOOK_SECRET=your-generated-secret

# ─── Cloudflare KV Binding (wrangler.toml — not an env var) ──────────────────
# Add to wrangler.toml:
#   [[kv_namespaces]]
#   binding = "CONTACT_RATE_LIMIT"
#   id = "your-kv-namespace-id"
# In local dev, the code falls back to an in-memory Map (no setup needed).

# ─── Cloudflare Pages deployment checklist ───────────────────────────────────
# 1. Create Turnstile site → copy site key (Texte) + secret (Secret)
# 2. Add NEXT_PUBLIC_TURNSTILE_SITE_KEY as Texte
# 3. Add TURNSTILE_SECRET as Secret
# 4. Add N8N_WEBHOOK_URL as Texte
# 5. Add N8N_WEBHOOK_SECRET as Secret
# 6. Create KV namespace "CONTACT_RATE_LIMIT" → add as Binding
# 7. In n8n Webhook node → Authentication → Header Auth
#    Header name: x-portfolio-secret  |  Value: same as N8N_WEBHOOK_SECRET
